# Won Ads – rules for Hostinger (upload once into public_html as ".htaccess")
# Makes clean URLs work: /services serves services.html.

Options -MultiViews
RewriteEngine On

# /index.html -> /
RewriteRule ^index\.html$ / [R=301,L]

# /services.html -> /services   (old links keep working, one URL per page for Google)
RewriteCond %{REQUEST_URI} !^/solar-system-source/
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /services/ -> /services   (remove trailing slash, except real folders)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /services -> serve services.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Unknown pages show the site's 404 page
ErrorDocument 404 /404.html

# Always use HTTPS in browsers (HSTS)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
